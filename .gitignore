.DS_Store
xcuserdata/
TunnelTerminalCore/.build/
TunnelTerminalCore/.swiftpm/

# Bauergebnisse, Logs und Auftragsablage – Logs und Ausgaben enthalten lokale Pfade mit Benutzernamen (S14)
build/*
!build/skript.sh
!build/m0/
build/m0/*
!build/m0/0*.sh
!build/m0/env.sh
!build/m0/run.sh
!build/m0/Prototyp/
build/m0/Prototyp/.build/
build/m0/Prototyp/.swiftpm/
!build/m1/
build/m1/*
!build/m1/*.sh
# U1: nur die Release-Prüfung; build/u1/cmd.sh (Datenumzug) bleibt lokal, weil es den alten Namen enthalten muss
!build/u1/
build/u1/*
!build/u1/pruef.sh
# M2: Generator der Zahlen-Schlüssel und Skripte (die Testquellen erzeugt build/m2/testquellen.sh, nur Platzhalter, S14)
!build/m2/
build/m2/*
!build/m2/putty-zahlen-schluessel.py
!build/m2/*.sh

# Fremdmaterial: PuTTY-Tarball und Leonards Vergleichs-Builds – nie ins Repo
Quellen/

# Plan (enthält Heimserver-Adressen), interne Arbeitsanweisungen und lokale Testsitzungen (S12)
# als Muster, damit auch Kopien unter früheren oder künftigen App-Namen nie ins Repo kommen
*_Entwicklungsplan.md
*_Prompts.md
Lokal/

# Design: nur die finale Logo-Richtung kommt ins Repo (U1); Vorrunde und die verworfene Namensvariante bleiben lokal
Design/*
!Design/Logo-Final/
Design/Logo-Final/_alt-TunnelSSH/
# Python-Bytecode enthält absolute Quellpfade mit Benutzernamen (S14)
__pycache__/
